---
import '@/styles/global.css'
import { ThemeToggle } from '@/components/ThemeToggle'
import { CopyCode } from '@/components/copy-code'
import { buttonVariants } from '@/components/ui/button'
import { withBase } from '@/lib/base'
import { cn } from '@/lib/utils'

interface Props {
  title?: string | undefined
  description?: string | undefined
  docs?: boolean
}

const { title, description, docs = false } = Astro.props
const documentTitle = title ? `Kafka | Core | ${title}` : 'Kafka | Core'
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="48x48" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
  </head>
  <body class="bg-background text-foreground min-h-screen font-sans antialiased">
    {
      docs && (
        <input type="checkbox" id="docs-nav" class="peer sr-only" />
      )
    }
    <header class="border-border bg-background/80 sticky top-0 z-50 border-b backdrop-blur">
      <nav class="relative flex h-14 w-full items-center px-4 lg:px-6">
        {
          docs && (
            <label
              for="docs-nav"
              class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }), 'z-10 lg:hidden')}
              aria-label="Toggle Core menu"
            >
              <svg
                class="docs-nav-menu size-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M4 5h16"></path>
                <path d="M4 12h16"></path>
                <path d="M4 19h16"></path>
              </svg>
              <svg
                class="docs-nav-close size-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path>
              </svg>
            </label>
          )
        }

        <div
          class={cn(
            'flex items-center gap-6',
            docs && 'max-lg:absolute max-lg:left-1/2 max-lg:-translate-x-1/2',
            !docs && 'mr-auto',
          )}
        >
          <a href={withBase('/')} class="flex items-center gap-2.5 font-semibold tracking-tight">
            <img src={withBase('/logo-icon.svg')} alt="" width="28" height="28" class="size-7" />
            Kafka
          </a>
          <a
            href={withBase('/docs/start/getting-started/')}
            class="text-muted-foreground hover:text-foreground hidden text-sm lg:inline"
          >
            Core
          </a>
        </div>

        <div class={cn('flex items-center gap-1', docs && 'ml-auto')}>
          <a
            href="https://github.com/cookieMonsterDev/kafka"
            class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }), docs && 'max-lg:hidden')}
            aria-label="GitHub repository"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              ></path>
            </svg>
          </a>
          {/* client:load hydrates these islands; the rest of the page stays static HTML */}
          <ThemeToggle client:load />
        </div>
      </nav>
    </header>

    <CopyCode client:load />

    {
      docs && (
        <>
          <label
            for="docs-nav"
            class="docs-nav-overlay bg-background/70 fixed inset-0 top-14 z-40 cursor-pointer backdrop-blur-sm"
            aria-label="Close Core menu"
          />
          <div
            id="docs-mobile-nav"
            class="docs-nav-drawer bg-sidebar border-sidebar-border fixed inset-y-0 left-0 top-14 z-40 w-full overflow-y-auto border-r px-4 py-6"
          >
            <slot name="mobile-nav" />
          </div>
        </>
      )
    }

    <slot />
  </body>
</html>
