---
import { getCollection } from 'astro:content'
import { docsPackageFromPathname, groupDocs, hrefFor, isCurrentPath, navLabel } from '@/lib/docs'
import { cn } from '@/lib/utils'

interface Props {
  class?: string
}

const pathname = Astro.url.pathname
const groups = groupDocs(await getCollection('docs'), docsPackageFromPathname(pathname))
---

<nav class={cn('min-w-0 text-sm', Astro.props.class)} aria-label="Documentation">
  {
    groups.map((group) => (
      <details open class="group/section mb-2 min-w-0">
        <summary class="text-muted-foreground hover:text-foreground flex cursor-pointer list-none items-center justify-between gap-2 rounded-md px-3 py-2 text-[0.6875rem] font-medium tracking-[0.1em] uppercase [&::-webkit-details-marker]:hidden">
          {group.label}
          <svg
            class="size-3.5 shrink-0 transition-transform group-open/section:rotate-180"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </summary>
        <ul class="flex flex-col gap-0.5 pb-3">
          {group.entries.map((entry) => {
            const href = hrefFor(entry)
            const current = isCurrentPath(href, pathname)
            return (
              <li>
                <a
                  href={href}
                  aria-current={current ? 'page' : undefined}
                  class={cn(
                    // The accent rail matches the studio's workspace nav, so the two products
                    // read as one system. Colour is never the only cue: the rail and the weight
                    // carry the current page too.
                    'relative block min-w-0 rounded-md px-3 py-1.5 break-words transition-colors',
                    'before:absolute before:top-1/2 before:left-0 before:h-4 before:w-[3px] before:-translate-y-1/2 before:rounded-r-full before:bg-primary before:opacity-0',
                    current
                      ? 'bg-sidebar-accent text-sidebar-accent-foreground font-medium before:opacity-100'
                      : 'text-muted-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground',
                  )}
                >
                  {navLabel(entry)}
                </a>
              </li>
            )
          })}
        </ul>
      </details>
    ))
  }
</nav>
