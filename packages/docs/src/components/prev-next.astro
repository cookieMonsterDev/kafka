---
interface Props {
  prev?: { href: string; label: string } | undefined
  next?: { href: string; label: string } | undefined
}

const { prev, next } = Astro.props
---

{
  (prev || next) && (
    <nav class="border-border mt-12 grid grid-cols-2 gap-2 border-t pt-6 sm:gap-4" aria-label="Page">
      {prev ? (
        <a
          href={prev.href}
          rel="prev"
          class="hover:border-ring hover:bg-muted/40 min-w-0 rounded-lg border border-transparent px-2 py-1.5 no-underline transition-colors sm:px-3 sm:py-2"
        >
          <span class="text-muted-foreground block text-xs">Previous</span>
          <span class="text-foreground block text-sm font-medium wrap-break-word sm:text-base">
            ← {prev.label}
          </span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a
          href={next.href}
          rel="next"
          class="hover:border-ring hover:bg-muted/40 col-start-2 min-w-0 rounded-lg border border-transparent px-2 py-1.5 text-right no-underline transition-colors sm:px-3 sm:py-2"
        >
          <span class="text-muted-foreground block text-xs">Next</span>
          <span class="text-foreground block text-sm font-medium wrap-break-word sm:text-base">
            {next.label} →
          </span>
        </a>
      )}
    </nav>
  )
}
