---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { buttonVariants } from '@/components/ui/button'
import {
  Card,
  CardAction,
  CardDescription,
  CardHeader,
  CardTitle,
} from '@/components/ui/card'

const entries = (await getCollection('docs')).sort(
  (a, b) => a.data.order - b.data.order,
)
---

<BaseLayout title="Kafka docs" description="Documentation for @kafka/core">
  <div class="flex items-center gap-3">
    <img src="/logo-icon.svg" alt="" width="48" height="48" class="size-12" />
    <h1 class="text-3xl font-semibold tracking-tight">@kafka/core</h1>
  </div>
  <p class="text-muted-foreground mt-2">
    TypeScript Kafka client — Kafka 0.10+, bigint offsets, generated types.
  </p>

  <div class="mt-8 grid gap-4">
    {
      entries.map((entry) => (
        <Card>
          <CardHeader>
            <CardTitle>{entry.data.title}</CardTitle>
            {entry.data.description && (
              <CardDescription>{entry.data.description}</CardDescription>
            )}
            <CardAction>
              {/* For links, apply buttonVariants to a plain <a>. `asChild` does
                  not work from .astro files — Radix's Slot clones a React
                  element, and Astro passes children as a slot, not an element. */}
              <a
                href={`/docs/${entry.id}/`}
                class={buttonVariants({ variant: 'secondary', size: 'sm' })}
              >
                Read
              </a>
            </CardAction>
          </CardHeader>
        </Card>
      ))
    }
  </div>
</BaseLayout>
