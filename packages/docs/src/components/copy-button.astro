---
import { cn } from '@/lib/utils'

interface Props {
  text: string
  label?: string
  class?: string
}

const { text, label = 'Copy' } = Astro.props
const labeled = Astro.slots.has('default')
---

<button
  type="button"
  class={cn(labeled ? 'copy-command' : 'copy-btn', Astro.props.class)}
  data-copy={text}
  aria-label={label}
  translate="no"
>
  <slot />
  <svg
    class="copy-icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
  </svg>
  <svg
    class="copy-check"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 6 9 17l-5-5"></path>
  </svg>
</button>
