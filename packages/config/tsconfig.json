{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    // `files: ["dist"]` in package.json never publishes `src`, so a `.d.ts.map`'s `sources` pointer
    // to `../src/...` resolves to nothing in an installed tarball, same as kafka-core's tsconfig.
    "declarationMap": false
  },
  "include": ["src/**/*.ts"]
}
