---
import { getCollection } from 'astro:content'
import { SECTION_LABELS, SECTION_ORDER, docsPackageFromPathname, groupDocs, hrefFor } from '@/lib/docs'
import { cn } from '@/lib/utils'

interface Props {
  class?: string
}

const pathname = Astro.url.pathname
const groups = groupDocs(await getCollection('docs'), docsPackageFromPathname(pathname))
const bySection = new Map(groups.map((group) => [group.section, group]))
const tabs = SECTION_ORDER.map((section) => ({
  section,
  label: SECTION_LABELS[section],
  href: bySection.get(section)?.entries[0] ? hrefFor(bySection.get(section)!.entries[0]!) : undefined,
}))
---

<nav class={cn('flex flex-col gap-0.5 text-sm', Astro.props.class)} aria-label="Documentation sections">
  {
    tabs.map((tab) =>
      tab.href != null ? (
        <a
          href={tab.href}
          class="text-muted-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground block rounded-md px-2 py-2 font-medium transition-colors"
        >
          {tab.label}
        </a>
      ) : (
        <span
          aria-disabled="true"
          class="text-muted-foreground pointer-events-none block rounded-md px-2 py-2 font-medium opacity-50"
        >
          {tab.label}
        </span>
      ),
    )
  }
</nav>
