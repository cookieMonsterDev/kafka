{
  "name": "@cookiemonsterdev/kafka-studio",
  "version": "1.4.1",
  "description": "A local web UI for inspecting and interacting with an Apache Kafka cluster, built on @cookiemonsterdev/kafka-core.",
  "type": "module",
  "license": "MIT",
  "author": "Mykhailo Toporkov",
  "homepage": "https://cookiemonsterdev.github.io/kafka/",
  "bugs": {
    "url": "https://github.com/cookieMonsterDev/kafka/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookieMonsterDev/kafka.git",
    "directory": "packages/studio"
  },
  "keywords": [
    "kafka",
    "apache-kafka",
    "studio",
    "ui",
    "admin",
    "typescript",
    "kafka-ui",
    "kafka-gui",
    "kafka-browser",
    "web-ui",
    "kafka-admin",
    "tanstack-intent"
  ],
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kafka-studio": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types && pnpm run build:web",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "build:web": "vite build --config vite.web.config.ts",
    "dev": "vite build --watch",
    "dev:server": "KAFKA_STUDIO_DEV=1 node dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:bun": "bun --bun ./node_modules/vitest/vitest.mjs run --project unit",
    "test:integration": "vitest run --project integration",
    "test:bun:integration": "bun --bun ./node_modules/vitest/vitest.mjs run --project integration",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "oxc-transform-react": "^0.157.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.6.7",
    "@xterm/xterm": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@cookiemonsterdev/kafka-cli": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "date-fns": "^4.4.0",
    "happy-dom": "^21.0.4",
    "react-day-picker": "^10.0.2"
  },
  "dependencies": {
    "@cookiemonsterdev/kafka-config": "^1.1.0",
    "@cookiemonsterdev/kafka-core": "^2.4.0",
    "@kafkajs/confluent-schema-registry": "^4.1.0",
    "protobufjs": "^8.8.1"
  }
}
