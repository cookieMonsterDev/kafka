{
  "name": "@cookiemonsterdev/kafka-core",
  "version": "2.0.0",
  "description": "TypeScript Apache Kafka client for Node.js. Speaks the Kafka wire protocol directly.",
  "type": "module",
  "license": "MIT",
  "author": "Mykhailo Toporkov",
  "homepage": "https://cookiemonsterdev.github.io/kafka/",
  "bugs": {
    "url": "https://github.com/cookieMonsterDev/kafka/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookieMonsterDev/kafka.git",
    "directory": "packages/core"
  },
  "keywords": [
    "kafka",
    "apache-kafka",
    "client",
    "producer",
    "consumer",
    "admin",
    "typescript"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit && tsc -p bench/tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "bench": "node bench/load-ts.mjs",
    "coverage": "vitest run --coverage",
    "test:cluster:up": "bash scripts/compose-up.sh",
    "test:cluster:down": "bash scripts/compose-down.sh",
    "test:cluster:pull": "bash scripts/compose-pull.sh",
    "certs": "bash scripts/generate-certificates.sh",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/snappyjs": "^0.7.1",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "lz4-lite": "^1.1.2",
    "snappyjs": "^0.7.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  }
}
