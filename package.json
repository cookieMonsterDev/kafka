{
  "name": "kafka",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Mykhailo Toporkov",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "dev": "pnpm -r --parallel --if-present run dev",
    "studio:dev": "pnpm --filter @cookiemonsterdev/kafka-studio... run build && pnpm --filter @cookiemonsterdev/kafka-studio run dev:server",
    "test": "pnpm -r --if-present run test",
    "test:bun": "pnpm -r --if-present run test:bun",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r --if-present run clean && rm -rf node_modules",
    "prepare": "husky",
    "docs:generate:cli": "node scripts/generate-cli-docs.mjs",
    "docs:generate:cli:check": "node scripts/generate-cli-docs.mjs --check",
    "theme:check": "node scripts/check-theme-drift.mjs",
    "seo:indexnow": "node scripts/submit-search-index.mjs",
    "release": "node scripts/run-semantic-release.mjs",
    "release:dry-run": "node scripts/run-semantic-release.mjs --dry-run"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "semantic-release-monorepo": "^8.0.2",
    "semver": "^7.8.5",
    "typescript-eslint": "^8.72.0"
  }
}
