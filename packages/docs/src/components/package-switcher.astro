---
import { getCollection } from 'astro:content'
import { PackageSwitcherSelect } from '@/components/package-switcher-select'
import { docsNavPackages, docsPackageFromPathname } from '@/lib/docs'

interface Props {
  class?: string
}

const pathname = Astro.url.pathname
const current = docsPackageFromPathname(pathname)
const packages = docsNavPackages(await getCollection('docs'))
---

<PackageSwitcherSelect client:load className={Astro.props.class} packages={packages} value={current} />
