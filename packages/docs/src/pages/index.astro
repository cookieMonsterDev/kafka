---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { buttonVariants } from '@/components/ui/button'
import { withBase } from '@/lib/base'
import { cn } from '@/lib/utils'
---

<BaseLayout
  description="TypeScript Kafka client for Node.js — Kafka 0.10+, bigint offsets, generated types."
>
  <main class="landing-hero relative flex min-h-[calc(100vh-3.5rem)] flex-col items-center justify-center px-6 py-20 text-center">
    <h1 class="max-w-3xl text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
      The TypeScript Kafka client for Node.js
    </h1>
    <p class="text-muted-foreground mt-6 max-w-2xl text-lg text-pretty">
      Talk to brokers from Kafka 0.10 onward. Produce, consume, and administer
      with <span class="text-foreground">bigint offsets</span> and types generated
      from source.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href={withBase('/docs/start/getting-started/')}
        class={cn(buttonVariants({ size: 'lg' }), 'h-10 px-5 bg-foreground text-background hover:bg-foreground/90')}
      >
        Get Started
      </a>
      <a
        href={withBase('/docs/start/introduction/')}
        class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'h-10 px-5')}
      >
        Learn more
      </a>
    </div>
    <button
      type="button"
      data-copy="npm install @cookiemonsterdev/kafka-core"
      class="text-muted-foreground hover:text-foreground mt-10 inline-flex items-center gap-2 border-0 bg-transparent p-0 font-mono text-sm"
      aria-label="Copy install command"
      title="Click to copy"
    >
      <img src={withBase('/logo-icon.svg')} alt="" width="14" height="14" class="size-3.5 opacity-70" />
      <span class="copy-label">npm install @cookiemonsterdev/kafka-core</span>
    </button>
  </main>
</BaseLayout>
