---
import type { MarkdownHeading } from 'astro'
import { cn } from '@/lib/utils'

interface Props {
  headings: MarkdownHeading[]
  class?: string
  showHeading?: boolean
}

const headings = Astro.props.headings.filter((heading) => heading.depth === 2 || heading.depth === 3)
const showHeading = Astro.props.showHeading ?? true
---

{
  headings.length > 0 && (
    <nav class={cn('text-sm', Astro.props.class)} aria-label="On this page">
      {showHeading && (
        <h2 class="text-muted-foreground mb-2 text-[0.6875rem] font-medium tracking-[0.1em] uppercase">
          On this page
        </h2>
      )}
      <ul class="border-border flex flex-col gap-1 border-l">
        {headings.map((heading) => (
          <li>
            {/* The current heading pulls the rail's own colour forward, matching the accent rail
                on both nav sidebars rather than inventing a third active treatment. */}
            <a
              href={`#${heading.slug}`}
              class={cn(
                'text-muted-foreground hover:text-foreground aria-[current=location]:text-foreground relative block py-1 font-normal transition-colors aria-[current=location]:font-medium',
                'before:bg-primary before:absolute before:top-1 before:bottom-1 before:-left-px before:w-[2px] before:rounded-full before:opacity-0 aria-[current=location]:before:opacity-100',
                heading.depth === 2 ? 'pl-3' : 'pl-6',
              )}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
