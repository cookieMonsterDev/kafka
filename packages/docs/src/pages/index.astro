---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CopyButton from '@/components/copy-button.astro'
import { buttonVariants } from '@/components/ui/button'
import { withBase } from '@/lib/base'
import { cn } from '@/lib/utils'

const install = 'npm install @cookiemonsterdev/kafka-core'
---

<BaseLayout
  description="TypeScript Kafka client for Node.js — Kafka 0.10+, types generated from source."
>
  <main
    id="main-content"
    tabindex="-1"
    class="landing-hero relative flex min-h-[calc(100vh-var(--header-height))] flex-col items-center justify-center px-6 py-20 text-center"
  >
    <h1 class="max-w-3xl text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
      The TypeScript Kafka client for Node.js
    </h1>
    <p class="text-muted-foreground mt-6 max-w-2xl text-lg text-pretty">
      Talk to brokers from Kafka 0.10 onward. Produce, consume, and administer.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href={withBase('/docs/start/getting-started/')}
        class={cn(buttonVariants({ size: 'lg' }), 'h-10 px-5 bg-foreground text-background hover:bg-foreground/90')}
      >
        Get started
      </a>
      <a
        href={withBase('/docs/start/introduction/')}
        class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'h-10 px-5')}
      >
        Introduction
      </a>
    </div>
    <CopyButton text={install} label="Copy install command" class="mt-10 font-mono text-sm">
      {install}
    </CopyButton>
  </main>
</BaseLayout>
