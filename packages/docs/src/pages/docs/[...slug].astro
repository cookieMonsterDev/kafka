---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import DocsLayout from '@/layouts/docs-layout.astro';
import { markdownHref, publication, packageVersions } from '@/lib/publication';
import { withBase } from '@/lib/base';
import { DEFAULT_DOCS_PACKAGE, docsPackageOf, hrefFor, navLabel, neighbors, pathFor } from '@/lib/docs';

export const getStaticPaths = (async () => {
  const entries = await getCollection('docs');
  const pages = entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, redirectTo: undefined },
  }));
  const legacy = entries.flatMap((entry) => {
    if (docsPackageOf(entry.id) !== DEFAULT_DOCS_PACKAGE) {
      return [];
    }
    const rest = entry.id.split('/').slice(1).join('/');
    if (rest.length === 0) {
      return [];
    }
    return [
      {
        params: { slug: rest },
        props: { entry: undefined, redirectTo: pathFor(entry) },
      },
    ];
  });
  return [...pages, ...legacy];
}) satisfies GetStaticPaths;

const { entry, redirectTo } = Astro.props;
if (redirectTo != null) {
  return Astro.redirect(withBase(redirectTo), 301);
}
if (entry == null) {
  return Astro.redirect(withBase('/docs/core/start/introduction/'), 302);
}

const { Content, headings } = await render(entry);
const entries = await getCollection('docs');
const { prev, next } = neighbors(entries, entry.id);
const pkg = docsPackageOf(entry.id);
const command = entry.data.commandPath;
const markdownUrl = markdownHref(entry);
const sourcePath = `packages/docs/src/content/docs/${entry.id}.md`;
const sourceUrl = `https://github.com/cookieMonsterDev/kafka/blob/${publication.revision}/${sourcePath}`;
const breadcrumbs = [
  { label: pkg, href: withBase(`/docs/${pkg}/start/introduction/`) },
  ...(command
    ? [
        { label: 'Commands', href: withBase('/docs/cli/reference/commands/') },
        ...command
          .slice(0, -1)
          .map((part) => ({ label: part, href: withBase(`/docs/cli/reference/commands/#${command[0]}`) })),
      ]
    : []),
];
---

<DocsLayout
  markdownUrl={markdownUrl}
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
  prev={prev ? { href: hrefFor(prev), label: navLabel(prev) } : undefined}
  next={next ? { href: hrefFor(next), label: navLabel(next) } : undefined}
>
  <nav aria-label="Breadcrumb" class="mb-4 text-sm text-muted-foreground">
    <ol class="flex flex-wrap items-center gap-2">
      {breadcrumbs.map((crumb) => (
        <li>
          <a href={crumb.href}>{crumb.label}</a>
          <span aria-hidden="true" class="ml-2">
            /
          </span>
        </li>
      ))}
      <li aria-current="page">{entry.data.title}</li>
    </ol>
  </nav>
  <div class="mb-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-muted-foreground">
    <span translate="no">
      {pkg} v{packageVersions[pkg]}
    </span>
    <a href={markdownUrl}>View Markdown</a>
    <button
      type="button"
      data-requires-js
      aria-label="Copy page"
      data-copy-page={markdownUrl}
      class="min-h-9 rounded-md px-1 underline"
    >
      Copy page
    </button>
    <a href={sourceUrl}>Page source</a>
    <a href={`https://github.com/cookieMonsterDev/kafka/edit/develop/${sourcePath}`}>Edit this page</a>
  </div>
  <article
    class:list={[
      'prose prose-neutral prose-invert min-w-0 max-w-none',
      entry.id === 'cli/reference/commands' && 'command-index',
    ]}
  >
    <h1>{entry.data.title}</h1>
    <Content />
  </article>
</DocsLayout>
