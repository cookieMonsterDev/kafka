{
  "name": "kafka",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Mykhailo Toporkov",
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "dev": "pnpm -r --parallel --if-present run dev",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r --if-present run clean && rm -rf node_modules",
    "prepare": "husky",
    "release:core": "node scripts/run-semantic-release.mjs core",
    "release:core:dry-run": "node scripts/run-semantic-release.mjs core --dry-run",
    "release:cli": "node scripts/run-semantic-release.mjs cli",
    "release:cli:dry-run": "node scripts/run-semantic-release.mjs cli --dry-run",
    "release:docs": "node scripts/run-semantic-release.mjs docs",
    "release:docs:dry-run": "node scripts/run-semantic-release.mjs docs --dry-run"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "semantic-release-monorepo": "^8.0.2",
    "semver": "^7.8.5",
    "typescript-eslint": "^8.67.0"
  }
}
