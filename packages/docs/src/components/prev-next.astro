---
interface Props {
  prev?: { href: string; label: string } | undefined
  next?: { href: string; label: string } | undefined
}

const { prev, next } = Astro.props
---

{
  (prev || next) && (
    <nav class="border-border mt-12 grid gap-4 border-t pt-6 sm:grid-cols-2" aria-label="Page">
      {prev ? (
        <a
          href={prev.href}
          rel="prev"
          class="hover:border-ring hover:bg-muted/40 rounded-lg border border-transparent px-3 py-2 no-underline transition-colors"
        >
          <span class="text-muted-foreground block text-xs">Previous</span>
          <span class="text-foreground font-medium">← {prev.label}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a
          href={next.href}
          rel="next"
          class="hover:border-ring hover:bg-muted/40 rounded-lg border border-transparent px-3 py-2 text-right no-underline transition-colors sm:col-start-2"
        >
          <span class="text-muted-foreground block text-xs">Next</span>
          <span class="text-foreground font-medium">{next.label} →</span>
        </a>
      )}
    </nav>
  )
}
