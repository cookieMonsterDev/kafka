---
import '@/styles/global.css'
import { ThemeToggle } from '@/components/ThemeToggle'
import { CopyCode } from '@/components/copy-code'
import { DocsSearch } from '@/components/docs-search'
import { buttonVariants } from '@/components/ui/button'
import { withBase } from '@/lib/base'
import { getSearchIndex } from '@/lib/search-index'
import { THEME_COLOR_DARK, THEME_COLOR_LIGHT, THEME_STORAGE_KEY } from '@/lib/theme'
import { cn } from '@/lib/utils'

interface Props {
  title?: string | undefined
  description?: string | undefined
  docs?: boolean
}

const { title, description, docs = false } = Astro.props
const documentTitle = title ? `Kafka | Core | ${title}` : 'Kafka | Core'
const canonicalUrl = Astro.url.href
const ogImage = new URL(withBase('/logo-512.png'), Astro.site ?? Astro.url).href
const fallbackDescription = 'TypeScript Kafka client for Node.js — Kafka 0.10+, types generated from source.'
const searchIndex = await getSearchIndex()
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <script is:inline define:vars={{ THEME_STORAGE_KEY, THEME_COLOR_DARK, THEME_COLOR_LIGHT }}>
      ;(function () {
        try {
          var stored = localStorage.getItem(THEME_STORAGE_KEY)
          var dark = stored ? stored === 'dark' : true
          document.documentElement.classList.toggle('dark', dark)
          var meta = document.querySelector('meta[name="theme-color"]')
          if (meta) meta.setAttribute('content', dark ? THEME_COLOR_DARK : THEME_COLOR_LIGHT)
        } catch (e) {}
      })()
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={THEME_COLOR_DARK} />
    <meta name="color-scheme" content="dark light" />
    <title>{documentTitle}</title>
    <meta name="description" content={description ?? fallbackDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description ?? fallbackDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="48x48" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
  </head>
  <body class="bg-background text-foreground min-h-screen font-sans antialiased">
    <a
      href="#main-content"
      class="bg-background text-foreground focus-visible:ring-ring sr-only focus-visible:not-sr-only focus-visible:absolute focus-visible:top-2 focus-visible:left-2 focus-visible:z-[60] focus-visible:rounded-md focus-visible:px-3 focus-visible:py-2 focus-visible:ring-3"
    >
      Skip to content
    </a>
    {
      docs && (
        <input type="checkbox" id="docs-nav" class="sr-only" />
      )
    }
    <header class="border-border bg-background/95 sticky top-0 z-50 border-b pt-[env(safe-area-inset-top)] backdrop-blur">
      <nav
        class="flex h-16 w-full items-center justify-between gap-3 pr-[max(1rem,env(safe-area-inset-right))] pl-[max(1rem,env(safe-area-inset-left))] lg:px-6"
        aria-label="Site"
      >
        <div class="flex min-w-0 items-center gap-1">
          {
            docs && (
              <label
                for="docs-nav"
                class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }), 'shrink-0 lg:hidden')}
                aria-label="Open documentation menu"
                aria-controls="docs-mobile-nav"
              >
                <svg
                  class="docs-nav-menu size-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M4 5h16"></path>
                  <path d="M4 12h16"></path>
                  <path d="M4 19h16"></path>
                </svg>
                <svg
                  class="docs-nav-close size-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M18 6 6 18"></path>
                  <path d="m6 6 12 12"></path>
                </svg>
              </label>
            )
          }

          <a href={withBase('/')} class="flex min-w-0 items-center gap-2.5 no-underline">
            <img src={withBase('/logo-icon.svg')} alt="" width="32" height="32" class="size-8 shrink-0" />
            <span class="flex items-baseline gap-2 whitespace-nowrap">
              <span class="text-foreground text-xl font-semibold tracking-tight">Kafka</span>
              <span class="text-border text-lg font-light select-none" aria-hidden="true">
                /
              </span>
              <span class="text-muted-foreground text-sm font-medium">core</span>
            </span>
          </a>
        </div>

        <div class="flex shrink-0 items-center gap-1">
          <DocsSearch client:load index={searchIndex} />
          <a
            href="https://github.com/cookieMonsterDev/kafka"
            class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }))}
            aria-label="GitHub repository"
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              ></path>
            </svg>
          </a>
          {/* client:load hydrates these islands; the rest of the page stays static HTML */}
          <ThemeToggle client:load />
        </div>
      </nav>
    </header>

    <CopyCode client:load />

    {
      docs && (
        <>
          <label
            for="docs-nav"
            class="docs-nav-overlay bg-background/70 fixed inset-0 top-[var(--header-height)] z-40 cursor-pointer backdrop-blur-sm"
            aria-label="Close documentation menu"
          />
          <div
            id="docs-mobile-nav"
            class="docs-nav-drawer bg-sidebar border-sidebar-border fixed inset-y-0 left-0 top-[var(--header-height)] z-40 w-full overflow-y-auto border-r px-4 py-6"
          >
            <slot name="mobile-nav" />
          </div>
          <script is:inline>
            document.addEventListener('keydown', function (event) {
              if (event.key !== 'Escape') return
              var nav = document.getElementById('docs-nav')
              if (nav instanceof HTMLInputElement && nav.checked) nav.checked = false
            })
          </script>
        </>
      )
    }

    <slot />
  </body>
</html>
