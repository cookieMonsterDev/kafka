---
import '@/styles/global.css'
import { ThemeToggle } from '@/components/ThemeToggle'

interface Props {
  title: string
  description?: string | undefined
}

const { title, description } = Astro.props
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body class="bg-background text-foreground min-h-screen font-sans antialiased">
    <header class="border-border border-b">
      <nav class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-6 py-4">
        <a href="/" class="font-semibold tracking-tight">Kafka docs</a>
        {/* client:load hydrates this island; the rest of the page stays static HTML */}
        <ThemeToggle client:load />
      </nav>
    </header>
    <main class="mx-auto max-w-3xl px-6 py-10">
      <slot />
    </main>
  </body>
</html>
